{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controllab.org/schemas/v1.0.0/ctrlab_manifest.schema.json",
  "title": "ControlLab .ctrlab Container Manifest Schema v1.0.0",
  "description": "Manifesto tipado do contêiner ZIP .ctrlab conforme Seção 9.1.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "format",
    "schema_version",
    "app_version",
    "created_at",
    "project_id",
    "project_revision",
    "hashes",
    "capabilities"
  ],
  "properties": {
    "format": {
      "const": "ctrlab"
    },
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.\\d+$"
    },
    "app_version": {
      "type": "string",
      "minLength": 1
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "modified_at": {
      "type": "string",
      "format": "date-time"
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "hashes": {
      "type": "object",
      "additionalProperties": {
        "type": "string",
        "pattern": "^[a-fA-F0-9]{64}$"
      }
    },
    "capabilities": {
      "type": "object",
      "additionalProperties": true,
      "required": ["required_features"],
      "properties": {
        "required_features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "optional_features": {
          "type": "array",
          "items": { "type": "string", "minLength": 1 }
        },
        "max_uncompressed_bytes": {
          "type": "integer",
          "minimum": 1
        },
        "max_members": {
          "type": "integer",
          "minimum": 1
        }
      }
    },
    "contents": {
      "type": "object",
      "additionalProperties": true
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    }
  }
}

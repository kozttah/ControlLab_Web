{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controllab.org/schemas/v1.0.0/rpc_request.schema.json",
  "title": "ControlLab RPC Request Schema v1.0",
  "description": "Contrato RPC de requisição (api_version = '1.0') conforme Seção 8.1 e Apêndice A.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "api_version",
    "request_id",
    "project_id",
    "project_revision",
    "operation",
    "payload",
    "options",
    "timeout_policy"
  ],
  "properties": {
    "api_version": {
      "const": "1.0"
    },
    "request_id": {
      "type": "string",
      "minLength": 1
    },
    "project_id": {
      "type": "string",
      "minLength": 1
    },
    "project_revision": {
      "type": "integer",
      "minimum": 0
    },
    "operation": {
      "type": "string",
      "pattern": "^[a-z][a-z0-9_]*(\\.[a-z][a-z0-9_]*)+$"
    },
    "payload": {
      "type": "object",
      "additionalProperties": true
    },
    "options": {
      "type": "object",
      "additionalProperties": true
    },
    "timeout_policy": {
      "type": "object",
      "additionalProperties": true,
      "required": ["hard_timeout_ms"],
      "properties": {
        "hard_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "soft_timeout_ms": {
          "type": "integer",
          "minimum": 1
        },
        "cancel_on_supersede": {
          "type": "boolean"
        }
      }
    }
  }
}

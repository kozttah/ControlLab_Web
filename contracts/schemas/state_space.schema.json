{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://controllab-web.local/schemas/v1.0.0/state_space.schema.json",
  "title": "Canonical StateSpace Schema v1.0.0",
  "description": "Modelo LTI em espaço de estados contínuo ou discreto conforme Seção 4.1 e Apêndice B.",
  "type": "object",
  "additionalProperties": false,
  "required": [
    "schema_version",
    "id",
    "revision",
    "kind",
    "dt",
    "state_names",
    "input_names",
    "output_names",
    "matrices",
    "units",
    "provenance"
  ],
  "properties": {
    "schema_version": {
      "type": "string",
      "pattern": "^1\\.0\\.\\d+$"
    },
    "id": {
      "type": "string",
      "minLength": 1
    },
    "revision": {
      "type": "integer",
      "minimum": 0
    },
    "kind": {
      "const": "StateSpace"
    },
    "dt": {
      "oneOf": [
        { "type": "null" },
        { "type": "number", "exclusiveMinimum": 0 }
      ]
    },
    "state_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "input_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "output_names": {
      "type": "array",
      "items": { "type": "string", "minLength": 1 }
    },
    "matrices": {
      "type": "object",
      "additionalProperties": false,
      "required": ["A", "B", "C", "D"],
      "properties": {
        "A": { "$ref": "tensor.schema.json#/$defs/MatrixFloat64" },
        "B": { "$ref": "tensor.schema.json#/$defs/MatrixFloat64" },
        "C": { "$ref": "tensor.schema.json#/$defs/MatrixFloat64" },
        "D": { "$ref": "tensor.schema.json#/$defs/MatrixFloat64" }
      }
    },
    "units": {
      "type": "object",
      "additionalProperties": true,
      "required": ["time", "inputs", "outputs"],
      "properties": {
        "time": { "type": "string", "minLength": 1 },
        "states": {
          "type": "array",
          "items": { "type": "string" }
        },
        "inputs": {
          "type": "array",
          "items": { "type": "string" }
        },
        "outputs": {
          "type": "array",
          "items": { "type": "string" }
        }
      }
    },
    "provenance": {
      "type": "object",
      "additionalProperties": true
    },
    "created_at": {
      "type": "string",
      "format": "date-time"
    },
    "content_hash": {
      "type": "string",
      "pattern": "^[a-fA-F0-9]{64}$"
    }
  }
}

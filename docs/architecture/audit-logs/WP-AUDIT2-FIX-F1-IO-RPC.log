import base64
import hashlib
import io
import json
import zipfile
import numpy as np
from control_lab.core import StateSpace, StateFeedbackController, dispatch
from control_lab.io import extract_lti_from_pvm, load_ctrlab, export_pvm
from control_lab.diagnostics import strict_json_dumps

plant=StateSpace([[0.,1.],[-3.,-1.]],[[0.],[1.]],[[1.,2.]],[[0.]],id="f9-λ",revision=2)
ctrl=StateFeedbackController([[1.,2.]],feedback_sign="negative",id="f9-k",revision=1)
def rpc(name, payload):
    return dispatch({"api_version":"1.0","project_id":"f9-project","request_id":"qa",
                     "project_revision":3,"operation":"io."+name,"payload":payload,
                     "options":{}, "timeout_policy":{"hard_timeout_ms":30000}})
def export(name,payload):
    response=rpc("export_"+name,payload)
    assert response['status'] in ('success','warning'),response
    data=response['result']
    raw=base64.b64decode(data["bytes_base64"],validate=True)
    assert len(raw)==data['size_bytes'] and hashlib.sha256(raw).hexdigest()==data['sha256']
    return raw
def imported(name,raw):
    res=rpc("import_"+name,{"bytes_base64":base64.b64encode(raw).decode()})
    assert res['status'] in ('success','warning'),res
    return res
try:
    pvm=export('pvm',{'plant':plant.to_dict(),'controller':ctrl.to_dict()})
    model=json.loads(pvm)
    np.testing.assert_allclose(extract_lti_from_pvm(model).A,[[0.,1.],[-4.,-3.]])
    expected=export_pvm(plant,ctrl)
    assert json.loads(expected.data['pvm_json'])['graph']==model['graph']
    ip=imported('pvm',pvm)
    assert ip['assumptions']['passive_import'] and not ip['assumptions']['code_executed']
    print('PVM: byte count, SHA-256, graph from official adapter, A_cl and passive import passed')
    z=export('ctrlab',{'project':{'project_id':'f9-project','project_revision':3,
                'models':[plant.to_dict()],'controllers':[ctrl.to_dict()]}})
    with zipfile.ZipFile(io.BytesIO(z)) as archive:
        assert archive.testzip() is None and 'manifest.json' in archive.namelist()
    native=load_ctrlab(z); assert native.status in ('success','warning')
    iz=imported('ctrlab',z)
    assert iz['result']['models']==[plant.to_dict()] and iz['result']['controllers']==[ctrl.to_dict()]
    assert iz['diagnostics']['hashes_verified'] and not iz['assumptions']['code_executed']
    print('CTRLAB: byte count, SHA-256, ZIP CRC, native importer, model and controller equality passed')
except Exception: raise

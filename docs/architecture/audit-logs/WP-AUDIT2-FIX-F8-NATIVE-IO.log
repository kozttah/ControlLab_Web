import json
from pathlib import Path
from tempfile import TemporaryDirectory
import numpy as np
from scripts.browser_harness import browser_harness
from control_lab.core import tensor_to_array
from control_lab.io import load_ctrlab, extract_lti_from_pvm
with TemporaryDirectory() as tmp:
 gen=browser_harness.__wrapped__()
 h=next(gen)
 try:
  p=h.page
  p.locator('[data-action="commit-lqr"]').click()
  p.wait_for_function('()=>Boolean(app.shell.getLqrWorkspace().getCommittedSnapshot())',timeout=30000)
  pre=p.evaluate('''()=>({plant:app.shell.getLqrWorkspace().getPlant(),snapshot:app.shell.getLqrWorkspace().getCommittedSnapshot()})''')
  print('Browser/Pyodide:',h.version,pre['snapshot']['provenance'])
  files={}
  for fmt in ['ctrlab','pvm']:
   p.locator('#btn-export-'+fmt).click()
   with p.expect_download(timeout=15000) as dl:
    p.locator('#export-modal-download').click(timeout=10000)
   download=dl.value
   assert download.suggested_filename.endswith('.'+fmt),download.suggested_filename
   path=Path(tmp,'result.'+fmt)
   download.save_as(path)
   files[fmt]=path
   print('UI download:',fmt,path.stat().st_size)
   if p.locator('#export-modal-close').is_visible():p.locator('#export-modal-close').click()
  z=load_ctrlab(files['ctrlab'].read_bytes()); assert z.status in ('success','warning'),z.error
  wire=pre['plant']; m=z.data['models'][0]; ctrl=z.data['controllers'][0]
  for key in ('matrices','units','dt','revision'):assert m[key]==wire[key],key
  assert ctrl['K']==pre['snapshot']['K'] and ctrl['feedback_sign']==pre['snapshot']['feedback_sign']
  assert z.data['manifest']['provenance']==pre['snapshot']['provenance']
  expected=tensor_to_array(m['matrices']['A'])-tensor_to_array(m['matrices']['B'])@tensor_to_array(ctrl['K'])
  np.testing.assert_allclose(extract_lti_from_pvm(files['pvm'].read_bytes()).A,expected)
  p.evaluate("""async()=>{app.destroy();document.body.replaceChildren();const node=document.createElement('div');document.body.append(node);const {mountControlLabApp}=await import('/app/main.js');globalThis.app=mountControlLabApp(node,{project_id:'f9-browser-project'}); await app.client.init()}""")
